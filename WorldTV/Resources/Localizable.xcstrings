    "about.availability": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel availability depends on third parties and is not guaranteed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilidad de los canales depende de terceros y no está garantizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilité des chaînes dépend de tiers et n'est pas garantie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A disponibilidade dos canais depende de terceiros e não é garantida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verfügbarkeit der Sender hängt von Dritten ab und ist nicht garantiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilità dei canali dipende da terze parti e non è garantita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルの視聴可否は第三者に依存しており、保証されるものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道可用性取决于第三方，不提供保证。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد توفر القنوات على أطراف ثالثة وغير مضمون."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैनलों की उपलब्धता तीसरे पक्ष पर निर्भर करती है और इसकी गारंटी नहीं है।"
          }
        }
      }
    },
    "about.channelRemoval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a channel review or removal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar la revisión o retirada de un canal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander une révision ou le retrait d'une chaîne"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar revisão ou remoção de um canal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überprüfung oder Entfernung eines Senders anfordern"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi una revisione o la rimozione di un canale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルの確認または削除をリクエスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求审核或移除频道"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب مراجعة أو إزالة قناة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैनल की समीक्षा या हटाने का अनुरोध करें"
          }
        }
      }
    },
    "about.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV discovers and plays free, publicly accessible television streams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV descubre y reproduce emisiones de televisión gratuitas y públicamente accesibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV découvre et lit des flux de télévision gratuits et accessibles au public."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O WorldTV descobre e reproduz fluxos de televisão gratuitos e publicamente acessíveis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV entdeckt und spielt kostenlose, öffentlich zugängliche Fernsehsender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV scopre e riproduce trasmissioni televisive gratuite e pubblicamente accessibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV は、無料で一般公開されているテレビ放送を発見して再生します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV 可发现并播放免费、可公开访问的电视流。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف WorldTV ويشغّل بثوث تلفزيونية مجانية ومتاحة للعموم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV मुफ़्त, सार्वजनिक रूप से सुलभ टेलीविज़न स्ट्रीम खोजता और चलाता है।"
          }
        }
      }
    },
