{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ · %@ %@": {
      "comment": "A description of the number of channels and countries available. The first argument is the number of channels. The second argument is the string “home.channelCount”. The fourth argument is the string “home.countryCount”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · %3$@ %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · %3$@ %4$@"
          }
        }
      }
    },
    "%lld / %lld": {
      "comment": "A label that shows the current source number and the total number of sources.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld %@": {
      "comment": "A secondary line of text that shows the number of channels in a country. The argument is the number of channels. The argument is the string “country.channels”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %2$@"
          }
        }
      }
    },
    "720p": {
      "comment": "A label for a 720p video.",
      "isCommentAutoGenerated": true
    },
    "1080p": {
      "comment": "A placeholder for a higher video quality.",
      "isCommentAutoGenerated": true
    },
    "2160p": {
      "comment": "A placeholder for a new video quality option.",
      "isCommentAutoGenerated": true
    },
