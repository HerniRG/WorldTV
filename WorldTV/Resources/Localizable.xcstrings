    "about.legalNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV does not host or retransmit content. Stream availability and rights remain the responsibility of their respective providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV no aloja ni retransmite contenido. La disponibilidad y los derechos de las emisiones corresponden a sus respectivos proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV n'héberge ni ne retransmet de contenu. La disponibilité des flux et leurs droits relèvent de la responsabilité de leurs fournisseurs respectifs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O WorldTV não hospeda nem retransmite conteúdo. A disponibilidade dos fluxos e os respectivos direitos são de responsabilidade dos seus fornecedores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV hostet oder überträgt keine Inhalte. Verfügbarkeit und Rechte der Streams liegen in der Verantwortung der jeweiligen Anbieter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV non ospita né ritrasmette contenuti. La disponibilità dei flussi e i relativi diritti restano di responsabilità dei rispettivi fornitori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV はコンテンツをホストまたは再送信しません。ストリームの可用性と権利は、それぞれの提供者の責任です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV 不托管或转播内容。流媒体可用性和权利由各自提供商负责。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستضيف WorldTV المحتوى ولا يعيد بثّه. تظل توفرية البثوث وحقوقها من مسؤولية مقدميها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WorldTV किसी सामग्री को होस्ट या पुनः प्रसारित नहीं करता। स्ट्रीम की उपलब्धता और अधिकार संबंधित प्रदाताओं की ज़िम्मेदारी हैं।"
          }
        }
      }
    },
