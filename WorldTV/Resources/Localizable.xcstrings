    "about.iptvOrg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog data is provided by the open source iptv-org project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del catálogo proceden del proyecto open source iptv-org."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du catalogue sont fournies par le projet open source iptv-org."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do catálogo são fornecidos pelo projeto de código aberto iptv-org."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Katalogdaten werden vom Open-Source-Projekt iptv-org bereitgestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del catalogo sono forniti dal progetto open source iptv-org."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログデータはオープンソースの iptv-org プロジェクトによって提供されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录数据由开源项目 iptv-org 提供。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توفير بيانات الكتالوج بواسطة مشروع المصدر المفتوح iptv-org."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैटलॉग डेटा ओपन सोर्स iptv-org प्रोजेक्ट द्वारा प्रदान किया जाता है।"
          }
        }
      }
    },
