    "sources.aboutDisclaimer" : {
      "comment" : "Attribution text explaining that the app does not provide or curate streams.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المصادر يضيفها المستخدم. لا تتضمن WorldTV بث القنوات أو تختارها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen werden vom Benutzer hinzugefügt. WorldTV stellt keine Senderstreams bereit und kuratiert sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources are added by the user. WorldTV does not provide or curate channel streams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes las añade el usuario. WorldTV no proporciona ni selecciona emisiones de canales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources sont ajoutées par l’utilisateur. WorldTV ne fournit ni ne sélectionne les flux des chaînes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्रोत उपयोगकर्ता जोड़ता है। WorldTV चैनल स्ट्रीम उपलब्ध या चयनित नहीं करता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti vengono aggiunte dall’utente. WorldTV non fornisce né seleziona i flussi dei canali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースはユーザーが追加します。WorldTV はチャンネルの配信を提供または選定しません。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes são adicionadas pelo utilizador. A WorldTV não fornece nem seleciona transmissões de canais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源由用户添加。WorldTV 不提供或筛选频道流。"
          }
        }
      }
    },
