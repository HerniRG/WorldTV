          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV no proporciona canales ni listas. Añade solo fuentes a las que tengas autorización para acceder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV ne fournit ni chaînes ni listes de lecture. Ajoutez uniquement des sources auxquelles vous êtes autorisé à accéder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV चैनल या प्लेलिस्ट उपलब्ध नहीं कराता। केवल उन्हीं स्रोतों को जोड़ें जिन तक पहुंचने की आपको अनुमति है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV non fornisce canali o playlist. Aggiungi solo fonti a cui sei autorizzato ad accedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV はチャンネルやプレイリストを提供しません。アクセスが許可されたソースのみ追加してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A WorldTV não fornece canais nem playlists. Adicione apenas fontes a que está autorizado a aceder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WorldTV 不提供频道或播放列表。请仅添加您获授权访问的来源。"
          }
        }
      }
    },
